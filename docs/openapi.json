{
  "openapi": "3.1.1",
  "info": {
    "title": "Lab6.Server | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:5080/"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Lab6.Server"
        ],
        "summary": "Стан сервера",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/crypto-keys/generate/rsa-keys": {
      "post": {
        "tags": [
          "Lab6.Server"
        ],
        "summary": "Створити пару RSA і повернути її integer ID",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "pattern": "^-?(?:0|[1-9]\\d*)$",
                  "type": [
                    "integer",
                    "string"
                  ],
                  "format": "int32"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/api/crypto-keys/rsa-public-key/{id}": {
      "get": {
        "tags": [
          "Lab6.Server"
        ],
        "summary": "Отримати публічний RSA ключ у Base64",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/crypto-keys/rsa-public-key": {
      "get": {
        "tags": [
          "Lab6.Server"
        ],
        "summary": "Отримати випадковий публічний ключ і заголовок x-rsa-id",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions": {
      "post": {
        "tags": [
          "Lab6.Server"
        ],
        "summary": "Передати зашифровані RSA параметри AES",
        "parameters": [
          {
            "name": "x-rsa-id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-session-id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CipherRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionCreated"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "404": {
            "description": "Not Found"
          },
          "409": {
            "description": "Conflict"
          }
        }
      }
    },
    "/api/messages": {
      "post": {
        "tags": [
          "Lab6.Server"
        ],
        "summary": "Обміняти AES повідомлення й отримати час приймання",
        "parameters": [
          {
            "name": "x-session-id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CipherRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CipherRequest"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "404": {
            "description": "Not Found"
          },
          "409": {
            "description": "Conflict"
          },
          "410": {
            "description": "Gone"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CipherRequest": {
        "required": [
          "cipherText"
        ],
        "type": "object",
        "properties": {
          "cipherText": {
            "type": "string"
          }
        }
      },
      "SessionCreated": {
        "required": [
          "sessionId",
          "expiresAt"
        ],
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "format": "uuid"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Lab6.Server"
    }
  ]
}